# Python
.venv/
__pycache__/
*.pyc

# Local machine state (mic calibration is per-machine)
ukejam_config.json

# Recorded audio clips
clips/

# macOS
.DS_Store

# Personal/local song content (copyrighted MIDI transcriptions — keep local, do not ship)
midi/

# Tooling
.playwright-mcp/

# App database (local data)
ukejam.db

# Tauri app build artifacts
app/node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/gen/

# Local research/experiments scratch area (large; not for distribution)
experiments/

# Loose dev screenshots in repo root
/*.png

# Generated docs/decks (kept local)
outputs/

# Large icon design master (generated icons are committed; master is not)
app/src/assets/ukejam-app-icon-master.png

# Swift SDK copies + resolved deps that `tauri ios` generates inside the local
# plugins. Build output, not source: they appear after any iOS build and would
# otherwise be committed by an unwitting `git add -A`.
app/tauri-plugin-*/.tauri/
app/tauri-plugin-*/ios/Package.resolved
